{
    "name": "fof/signature",
    "description": "Adds signature support to your Flarum forum.",
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "email": "hello@flarum.org"
        }
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "source": "https://github.com/FriendsOfFlarum/signature",
        "issues": "https://github.com/FriendsOfFlarum/signature/issues",
        "forum": "https://discuss.flarum.org/d/28108"
    },
    "replace": {
        "katosdev/signature": "*"
    },
    "require": {
        "php": "^8.2",
        "flarum/core": "^1.8.0"
    },
    "autoload": {
        "psr-4": {
            "FoF\\Signature\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Signature",
            "category": "feature",
            "icon": {
                "name": "fas fa-pen-square",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "*",
        "flarum/testing": "^1.0.0",
        "flarum/bbcode": "*",
        "flarum/markdown": "*"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\Signature\\Tests\\": "tests/"
        }
    }
}
